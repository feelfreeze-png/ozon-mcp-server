# Ozon Seller API (опционально — магазины удобнее добавлять через веб-UI /shops)
OZON_CLIENT_ID=
OZON_API_KEY=

# Ozon Performance API (реклама)
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# Токен авторизации MCP-эндпоинтов (/sse и /messages).
# ОБЯЗАТЕЛЬНО задать при доступе из внешней сети!
# Сгенерировать: openssl rand -hex 32
# Клиент передаёт: Authorization: Bearer <токен> или ?token=<токен>
MCP_AUTH_TOKEN=

# Токен веб-интерфейса (/shops, /api/*, дашборд, авто-дока FastAPI).
# ОБЯЗАТЕЛЬНО задать: без него веб-интерфейс открыт всем, кто дотянулся до порта —
# список магазинов, их заведение и УДАЛЕНИЕ, статистика всех арендаторов.
# Привязка клиента по MCP_CLIENT_TOKENS этого не закрывает: она про MCP-сессию, а не
# про админку. Открытым остаётся только /api/health (его дёргает healthcheck
# контейнера) — и без токена он отдаёт лишь живость, без подробностей.
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

# Личный токен на клиента: <токен>:<shop_id> через запятую.
# Магазины ОДНОГО клиента перечисляются через | — владелец нескольких кабинетов
# это один клиент с одним токеном, а не несколько токенов. Первый в списке —
# магазин по умолчанию (подставится, если shop_id не назван явно).
#
# Токен перестаёт быть пропуском и становится удостоверением. Нужен там, где одним
# сервером пользуются несколько владельцев: иначе клиент, узнавший чужой shop_id,
# тратит чужой рекламный бюджет.
#
# Чужой shop_id обрабатывается ПО-РАЗНОМУ, и это намеренно:
#   один магазин у токена  — молча ПОДСТАВЛЯЕТСЯ свой (выбора нет, подменить нечем);
#   несколько              — ОТВЕРГАЕТ вызов (kind: forbidden). Подставить нечего,
#                            а вернуть числа соседа под чужим именем — хуже отказа.
#
# ⚠️ Перечисляйте ВСЕ кабинеты клиента сразу. Токен, выданный на один магазин из
# четырёх, не выглядит ошибкой ни с одной стороны: ozon_list_shops честно отдаёт
# один, модель по нему отчитывается и пишет, что покрытие полное.
#
# Пока переменная пуста — режим выключен, работает MCP_AUTH_TOKEN как обычно.
# Если она задана, MCP_AUTH_TOKEN перестаёт пускать: он не привязан к магазину,
# и оставить его значило бы оставить обход.
# Сгенерировать: openssl rand -hex 32
# MCP_CLIENT_TOKENS=a1b2...:shop_alfa|shop_gamma,c3d4...:shop_beta

# Режим только для чтения: 1 / true / yes / on.
# Запрещает инструменты, меняющие рекламу — ставки, бюджеты, состав товаров,
# запуск и остановку кампаний, «оплату за заказ». Нужен там, где ассистенту дают
# боевой кабинет, но ещё не готовы доверить распоряжаться деньгами: ошибка модели
# в ставке тратит их немедленно и откатывается только руками.
# Чтение статистики, ставок, остатков и зон размещения работает как обычно;
# генерация отчётов тоже — она денег не тратит.
# OZON_READONLY=1

# Интервал фоновой диагностики Ozon API в минутах (0 = выключить)
HEALTH_CHECK_INTERVAL_MIN=30

# Директория данных (shops.json, stats.db, .encryption_key)
# DATA_DIR=/data

# Порт сервера (по умолчанию 8000)
# PORT=8000
